<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType><TargetFramework>net8.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms><ImplicitUsings>enable</ImplicitUsings><Nullable>enable</Nullable>
    <AssemblyName>Center</AssemblyName><ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
    <PlatformTarget>x64</PlatformTarget><VlcWindowsX86Enabled>false</VlcWindowsX86Enabled><VlcWindowsArm64Enabled>false</VlcWindowsArm64Enabled><VlcWindowsX64Enabled>true</VlcWindowsX64Enabled>
  </PropertyGroup>
  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
    <EmbeddedResource Include="Web\*" />
    <EmbeddedResource Include="Catalog\models.json" />
    <Content Include="Assets\Dark\*" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <PackageReference Include="LibVLCSharp.WinForms" Version="3.10.2" />
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.3124.44" />
    <PackageReference Include="VideoLAN.LibVLC.Windows" Version="3.0.24" />
    <PackageReference Include="System.Security.Cryptography.ProtectedData" Version="4.7.0" />
  </ItemGroup>
  <ItemGroup>
    <Reference Include="IntegrationService.COMIBCloudClient"><HintPath>C:/Seventh/IntegrationService/IntegrationService.COMIBCloudClient.dll</HintPath></Reference>
    <Reference Include="Google.Protobuf"><HintPath>C:/Seventh/IntegrationService/Google.Protobuf.dll</HintPath></Reference>
    <Reference Include="Grpc.Core.Api"><HintPath>C:/Seventh/IntegrationService/Grpc.Core.Api.dll</HintPath></Reference>
    <Reference Include="Grpc.Net.Client"><HintPath>C:/Seventh/IntegrationService/Grpc.Net.Client.dll</HintPath></Reference>
    <Reference Include="Grpc.Net.Common"><HintPath>C:/Seventh/IntegrationService/Grpc.Net.Common.dll</HintPath></Reference>
  </ItemGroup></Project>

